# Zenn Asistan — server only, never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional: override the assistant model (default claude-haiku-4-5-20251001).
ZENN_ASSISTANT_MODEL=

# Lesson requests go to the studio CRM's "Gelen aramalar" (server only).
# URL: https://<crm domain>/api/webhooks/web-request
# SECRET: the same value as WEB_REQUEST_WEBHOOK_SECRET on the CRM (HMAC-signed
# requests). In production a request fails loudly when either is missing.
REGISTRATION_WEBHOOK_URL=
REGISTRATION_WEBHOOK_SECRET=

# Contact details (phone, WhatsApp, e-mail…) live in src/content/company.ts.
